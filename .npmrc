# Установка — только `npm ci`, без legacy-peer-deps.
# Приватные пакеты — из GitLab Package Registry (раскомментировать, когда пакет опубликован):
# @ss:registry=https://gitlab.example.kg/api/v4/projects/<id>/packages/npm/
# //gitlab.example.kg/api/v4/projects/<id>/packages/npm/:_authToken=${CI_JOB_TOKEN}
engine-strict=true
