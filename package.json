{
  "name": "e-judge-selection-front-2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4000 --host 0.0.0.0",
    "build": "ng build --configuration development",
    "build:production": "ng build --configuration production",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "ng test",
    "e2e": "playwright test",
    "api:gen": "openapi-typescript $GATEWAY/docs/api/v3/api-docs -o src/domain/api/api.schema.ts && openapi-typescript $GATEWAY/docs/auth/v3/api-docs -o src/domain/api/auth.schema.ts",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "api:java": "node scripts/schema-from-java.mjs"
  },
  "dependencies": {
    "@angular/cdk": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@primeuix/themes": "^2.0.3",
    "@reforgium/data-grid": "2.2.3",
    "@reforgium/internal": "1.2.0",
    "@reforgium/presentia": "~1.4.2",
    "@reforgium/statum": "2.1.1",
    "dompurify": "^3.4.0",
    "primeicons": "^7.0.0",
    "primeng": "~21.1.10",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.24",
    "@angular/cli": "~21.2.24",
    "@angular/compiler-cli": "~21.2.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^24.10.0",
    "angular-eslint": "~21.4.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
